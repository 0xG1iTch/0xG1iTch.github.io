---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/content';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="Page not found"><section class="page-intro"><h1>A loose page<span class="accent">.</span></h1><p>This page isn’t in the notebook. It may have moved, or the address may be incomplete.</p><a class="text-link" style="margin-top:24px" href={withBase('writing/')}>Back to the notebook <Arrow size={18}/></a></section></BaseLayout>
